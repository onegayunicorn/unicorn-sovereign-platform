FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
RUN pip install --no-cache-dir fastapi uvicorn pydantic sqlalchemy celery redis qiskit qiskit-aer cryptography
COPY unicorn-quantum/apps/api ./api
COPY unicorn-quantum/packages ./packages
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
