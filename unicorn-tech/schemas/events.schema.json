    "event_type": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "timestamp": {
      "type": "number"
    },
    "payload": {
      "type": "object"
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false
