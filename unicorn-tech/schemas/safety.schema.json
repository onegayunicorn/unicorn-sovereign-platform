{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SafetyGateEvent",
  "type": "object",
  "required": [
    "gate_id",
    "node_id",
    "passed",
    "reason",
    "timestamp",
    "severity"
  ],
  "properties": {
    "gate_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "timestamp": {
      "type": "number"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    }
  },
  "additionalProperties": false
}