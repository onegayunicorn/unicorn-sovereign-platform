{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PluginManifest",
  "type": "object",
  "required": [
    "plugin_id",
    "name",
    "version",
    "permissions",
    "sandbox_level",
    "entrypoint"
  ],
  "properties": {
    "plugin_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sandbox_level": {
      "type": "string",
      "enum": [
        "isolated",
        "restricted",
        "full"
      ]
    },
    "entrypoint": {
      "type": "string"
    }
  },
  "additionalProperties": false
}