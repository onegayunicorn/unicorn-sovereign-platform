{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experiment",
  "type": "object",
  "required": [
    "experiment_id",
    "node_ids",
    "basis_selection_method",
    "timestamping_method",
    "coincidence_window_ns",
    "shots",
    "classification"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "basis_selection_method": {
      "type": "string"
    },
    "timestamping_method": {
      "type": "string"
    },
    "coincidence_window_ns": {
      "type": "number"
    },
    "shots": {
      "type": "integer",
      "minimum": 1
    },
    "classification": {
      "type": "string",
      "enum": [
        "Demonstrated",
        "Prototype",
        "Simulated",
        "Reported",
        "Proposed"
      ]
    }
  },
  "additionalProperties": false
}